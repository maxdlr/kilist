# Copy to .env.local and fill in. Expo reads it at build time; restart Metro after a change.

# Kilist API, including /api.
# Real phone on the same network: your computer's address.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4005/api
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:4005/api
# `make release` ignores this and uses RELEASE_API_URL from the Makefile.

# Google sign-in: the "Web application" OAuth client ID, the same value as
# GOOGLE_CLIENT_IDS in the API. Leave empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Release signing lives in a separate file, .release.env, read by `make release`:
# RELEASE_KEYSTORE=/absolute/path/to/kilist-release.jks
# RELEASE_KEY_ALIAS=kilist
# RELEASE_KEYSTORE_PASSWORD=
